# 하이씨앤씨에서 사용할 저장 위치를 확정한 뒤 설정한다.
# 미설정 빌드는 /setup으로 이동한다. 예시 교재나 가짜 계정으로 대신하지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 전용. Vercel 비공개 환경변수에 설정하고 VITE_ 접두어를 붙이지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NGS_BASE_URL=
NGS_AUTH=
NGS_APPKEY=
NGS_CODE=
BMS_BASE_URL=
FPS_BASE_URL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# VITE_NGS_* / VITE_FPS_* 값은 배포용 설정에 넣지 않는다.
# PC 앱과 웹은 같은 출처의 /api/ngs 및 /api/fps 중계를 사용한다.
