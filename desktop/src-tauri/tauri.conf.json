{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "하이씨앤씨 펜클래스",
  "version": "0.1.2",
  "identifier": "com.hicnc.penclass",
  "build": {
    "frontendDist": "../dist-shell",
    "beforeBuildCommand": "node ../scripts/prepare-desktop-shell.mjs"
  },
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "하이씨앤씨 펜클래스",
        "dragDropEnabled": false,
        "url": "https://hicnc-penclass.vercel.app/t/papers",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
